# ============================================================
# Firebase Configuration - Windows XP Portfolio
# ============================================================
# This file is SAFE TO COMMIT — it contains no real secrets.
#
# Setup:
# 1. Go to https://console.firebase.google.com
# 2. Create a project (or use existing)
# 3. Go to: Project Settings → Your Apps → Web App → SDK Config
# 4. Copy your values and paste into .env.local (NOT this file)
# ============================================================

NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_API_KEY_HERE
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_APP_ID

# ============================================================
# After filling in values:
# 1. Copy this file:    cp .env.example .env.local
# 2. Fill in real values in .env.local (it's gitignored)
# 3. Enable Firebase services:
#    - Authentication → Email/Password + Google
#    - Firestore Database → Create in test mode
# 4. Run: npm run dev
# ============================================================
